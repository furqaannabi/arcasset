# ArcAsset backend configuration.
#
# Copy to .env, point DATABASE_URL at a Postgres, and it runs: Arc testnet,
# agent off, paid API off, documents on local disk. Everything below turns
# something on, and GET /health reports what is actually running — a
# half-configured process should be obvious rather than quiet.
#
# Do not define a key twice. The last one silently wins.


# ─── Server ───────────────────────────────────────────────────────────────────

PORT=3001

# A hosted Postgres. Quote it, and mind the closing quote — dotenv keeps an
# unterminated one as part of the value, and Prisma then reports the scheme as
# unrecognised rather than the quote as missing.
DATABASE_URL="postgresql://user:password@host:5432/database"


# ─── Chain ────────────────────────────────────────────────────────────────────

# 5042002 is Arc testnet; 5042 is mainnet. Contract addresses are read from
# contracts/deployments/<CHAIN_ID>.json, never hardcoded.
CHAIN_ID=5042002
RPC_URL=https://rpc.testnet.arc.network


# ─── Servicing agent ──────────────────────────────────────────────────────────
#
# Without AGENT_PRIVATE_KEY the agent does not run, nothing is serviced
# automatically, and repayment still works by hand.
#
# The key is hot and acts unattended, so the rails below are not decoration.
# ServicingRelay is written so a fully compromised agent key can grief and not
# steal — the fee goes to an address fixed at issuance, never to msg.sender.

AGENT_PRIVATE_KEY=

# The demo runs at 5000 to make the loop visible on camera.
TICK_INTERVAL_MS=60000

# A bad read must not be able to produce ten thousand transactions before a
# human notices.
MAX_ACTIONS_PER_TICK=25

# Arc blocks average ~0.51s, so 200 is roughly 100 seconds of tolerated lag.
# Past it the agent skips the tick rather than acting on stale state.
MAX_LAG_BLOCKS=200

# 18-decimal native units. Below this the agent stops rather than half-servicing
# a note. This is a gas float — keep it small and boring, and never point
# INTEL_PAY_TO at the same address, or revenue lands here and the alarm stops
# meaning anything.
MIN_GAS_BALANCE=10000000000000000

# Marking a real borrower defaulted is the one irreversible thing this system
# does. Opt in explicitly, with a human present. Any value other than the exact
# string "false" leaves it on.
DEFAULT_DRY_RUN=true


# ─── Personhood ───────────────────────────────────────────────────────────────
#
# Selfie Check has no on-chain proof artifact, so the backend verifies with
# World's cloud API and signs an attestation the contract can check. What that
# costs is in docs/06-identity.md: the chain stops proving personhood and starts
# proving this server said so.

# MUST be the address AttestedVerifier was deployed with. A mismatch rejects
# every attestation on-chain, and rejects it identically to a forgery — which is
# the failure that wastes a day. GET /identity/status compares yours against the
# deployed contract, so check there first.
ATTESTOR_PRIVATE_KEY=

# From the World developer portal. Unset means /identity/attest returns 503.
WORLD_APP_ID=
WORLD_ACTION=

# Development only, for working without World credentials. It issues
# attestations with no personhood check at all — the sybil defence is simply
# off, and one person with two wallets gets two identities. Named so it cannot
# be set by accident; every response it touches carries a WARNING and both
# /health and /identity/status report it. Demoing with this on would be demoing
# no gate.
DANGEROUS_ATTEST_WITHOUT_WORLD=false


# ─── Paid API (x402) ──────────────────────────────────────────────────────────
#
# Unset INTEL_PAY_TO and /intel/* returns 503 rather than serving unpaid.

INTEL_PAY_TO=

# Circle's FiatToken on Arc. Note this is the *6-decimal* ERC-20 view of the
# same balance that msg.value sees at 18 decimals — prices here are 6dp, and
# amounts in the data are 18dp. Mixing them is a factor of a trillion, in the
# direction of giving the data away.
USDC_ERC20=0x3600000000000000000000000000000000000000

# Bounds what one settlement may cost us; it does not set the gas. EIP-3009
# settlement runs SignatureChecker as an external library call and needs well
# over 200k, so a ceiling that low starves it — and an out-of-gas revert carries
# no reason string, which looks exactly like a bad signature.
MAX_SETTLE_GAS=500000


# ─── Documents ────────────────────────────────────────────────────────────────
#
# All four R2 values, or storage falls back to the filesystem under .documents/
# and reads stream through the API under the same access check.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional custom domain, so presigned links do not expose the account id. The
# signature still travels in the query string and still expires.
#
# It must NOT have public access enabled. These are loan agreements naming
# people who did not agree to publish anything, and the
# originator/borrower/admin rule lives in the route — a public bucket bypasses
# it entirely, and a leaked link resolves forever instead of for sixty seconds.
# At startup the backend writes a probe object and tries to read it back
# unsigned; if that works it says so in /health under documents.WARNING.
R2_PUBLIC_URL=

# Comma-separated. Who may approve a proposal's documents. An admin can only
# block issuance — they cannot alter terms, mint, or accept for a borrower.
ADMIN_ADDRESSES=
