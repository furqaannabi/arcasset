# Database — matches docker-compose.yml
DATABASE_URL="postgresql://arcasset:arcasset@127.0.0.1:5432/arcasset?schema=public"

# Chain
CHAIN_ID=5042002
RPC_URL=https://rpc.testnet.arc.network

# Servicing agent. Without a key the agent does not run and repayment still
# works by hand — see GET /health.
AGENT_PRIVATE_KEY=
TICK_INTERVAL_MS=60000
MAX_ACTIONS_PER_TICK=25
MAX_LAG_BLOCKS=200
MIN_GAS_BALANCE=10000000000000000
# Marking a real borrower defaulted is the one irreversible act. Flip only with
# a human present.
DEFAULT_DRY_RUN=true

# Paid API (x402). Prices are 6-decimal base units — the ERC-20 view of USDC,
# which is what EIP-3009 signs against. $0.50 is 500000, not 500000000000000000.
INTEL_PAY_TO=
USDC_ERC20=0x3600000000000000000000000000000000000000
# EIP-3009 settlement runs SignatureChecker as an external library call; it
# costs well over 200k. This bounds the cost, it does not set it.
MAX_SETTLE_GAS=500000

# Documents
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Comma-separated. Who may approve a proposal's documents.
ADMIN_ADDRESSES=