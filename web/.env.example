# Chain: "arc" for mainnet, anything else selects Arc Testnet (the default).
NEXT_PUBLIC_CHAIN=arcTestnet

# Optional RPC override; falls back to the chain's public RPC.
NEXT_PUBLIC_RPC_URL=

# Subgraph Studio query endpoint. The UI's only read path.
NEXT_PUBLIC_SUBGRAPH_URL=

# Servicing agent base URL, for the /agent console.
NEXT_PUBLIC_AGENT_URL=http://localhost:3001
