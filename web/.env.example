# Chain: "arc" for mainnet, anything else selects Arc Testnet (the default).
NEXT_PUBLIC_CHAIN=arcTestnet

# Optional RPC override; falls back to the chain's public RPC.
NEXT_PUBLIC_RPC_URL=

# Subgraph Studio query endpoint. The UI's only read path.
# Studio's development endpoint — free, rate-limited, no API key. Bump the
# version segment on every `bun run deploy:studio`.
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1758626/arcasset/v0.0.3


# Local-only: skip the World ID gate on /propose so the form can be worked on
# before the personhood verifier exists. Leave unset anywhere real — it only
# bypasses the UI, and propose() still reverts on-chain for an unverified
# address, so a page that looks like it works will not.
NEXT_PUBLIC_BYPASS_VERIFICATION=

# Backend base URL. One process serves /identity, /documents, /intel and the
# agent's /health.
NEXT_PUBLIC_API_URL=http://localhost:3001

# World, from the developer portal. app_id must match WORLD_APP_ID on the
# backend, and the action must match WORLD_ACTION exactly — the nullifier is
# derived from (app, action, human), so a mismatch means a different identity.
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION=personhood

# "orb" (default) or "device". Orb is the only level that backs the claim this
# app makes — a unique living person. Device proves a distinct device, so one
# person with two phones is two identities. If you set device, say so in the
# README and the demo; do not call it proof of personhood.
NEXT_PUBLIC_WORLD_VERIFICATION_LEVEL=orb

# World network. Unset = production. Staging apps can only be completed in the
# simulator (simulator.worldcoin.org), and the simulator rejects a request
# built against the production bridge — the bridge carries the environment,
# not the app id. While the portal app is in Staging:
#   NEXT_PUBLIC_WORLD_BRIDGE_URL=https://staging-bridge.worldcoin.org
#
# Staging is completed in the World ID Simulator, not the World App. Leave this
# unset for production. The backend needs no matching change — it verifies
# against the same /api/v2/verify/{app_id} either way — which also means it
# cannot tell you which environment a proof came from.
NEXT_PUBLIC_WORLD_BRIDGE_URL=
